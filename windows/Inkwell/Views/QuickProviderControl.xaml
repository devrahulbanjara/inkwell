<UserControl x:Class="Inkwell.Views.QuickProviderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Header -->
        <Grid Margin="-6,-4,-6,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource FluentIconButton}" Click="Back_Click" ToolTip="Back to dashboard (Esc)">
                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="14" />
            </Button>
            <TextBlock Grid.Column="1" Text="AI Provider" Style="{StaticResource BaseText}" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
            <Button Grid.Column="2" Style="{StaticResource FluentIconButton}" Click="Settings_Click" ToolTip="Open full settings">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" />
            </Button>
        </Grid>

        <!-- Provider strip -->
        <UniformGrid x:Name="ProviderStrip" Rows="1" Margin="-3,0,-3,12" />

        <ScrollViewer x:Name="Scroller" Height="430" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
            <StackPanel x:Name="Body" />
        </ScrollViewer>
    </StackPanel>
</UserControl>
