<UserControl x:Class="Inkwell.Views.QuickProviderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="348">
    <StackPanel>
        <!-- Header -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource FluentIconButton}" Click="Back_Click" ToolTip="Back to dashboard">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
            </Button>
            <TextBlock Grid.Column="1" Text="AI Provider" Style="{StaticResource BaseText}"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
            <Button Grid.Column="2" Style="{StaticResource FluentIconButton}" Click="Settings_Click" ToolTip="Open full settings">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
            </Button>
        </Grid>

        <!-- Provider strip -->
        <Grid x:Name="ProviderStrip" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <!-- Scrollable detail -->
        <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
                <!-- Activation row -->
                <Grid Margin="0,0,0,12">
                    <StackPanel x:Name="ActiveBadge" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="ActiveLabel" Style="{StaticResource BaseText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="ActivateRow" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="ActivateButton" Style="{StaticResource FluentPrimaryButton}" Padding="10,5" FontSize="12" Click="Activate_Click" />
                        <TextBlock x:Name="ActivateNotice" Style="{StaticResource BaseText}" FontSize="11.5" Foreground="#F97316"
                                   VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="185" />
                    </StackPanel>
                </Grid>

                <!-- API Section -->
                <StackPanel x:Name="ApiSection">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="API KEYS" Style="{StaticResource BaseText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button x:Name="ToggleAddKeyButton" Style="{StaticResource FluentIconButton}" HorizontalAlignment="Right" Padding="4" Click="ToggleAddKey_Click" ToolTip="Add a key">
                            <TextBlock x:Name="ToggleAddKeyGlyph" Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Inline Add Key Form -->
                    <Border x:Name="AddKeyForm" Style="{StaticResource FluentCard}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="NewKeyBox" Style="{StaticResource FluentPasswordBox}" KeyDown="NewKeyBox_KeyDown" />
                                <Button Grid.Column="1" Style="{StaticResource FluentIconButton}" Margin="4,0,0,0" ToolTip="Paste from clipboard" Click="PasteKey_Click">
                                    <TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                            </Grid>
                            <TextBox x:Name="NewLabelBox" Style="{StaticResource FluentTextBox}" Margin="0,0,0,6" ToolTip="Optional label (e.g. Personal)" />
                            <TextBlock x:Name="KeyErrorText" Style="{StaticResource BaseText}" FontSize="11" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
                            <Grid>
                                <TextBlock VerticalAlignment="Center">
                                    <Hyperlink Click="OpenKeyUrl_Click" Foreground="{DynamicResource AccentBrush}">
                                        <Run Text="Get a free key →" />
                                    </Hyperlink>
                                </TextBlock>
                                <Button x:Name="SaveKeyButton" Content="Add key" Style="{StaticResource FluentPrimaryButton}"
                                        HorizontalAlignment="Right" Padding="10,4" FontSize="11.5" Click="AddKey_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="KeysList" Margin="0,0,0,10" />

                    <TextBlock Text="MODELS" Style="{StaticResource BaseText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2" />
                    <TextBlock Text="#1 is used first; the rest are fallbacks when it's limited. Click to toggle."
                               Style="{StaticResource BaseText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <StackPanel x:Name="ModelsList" />

                    <Grid Margin="0,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomModelBox" Style="{StaticResource FluentTextBox}" FontFamily="Consolas, Segoe UI" FontSize="11.5" KeyDown="CustomModelBox_KeyDown" />
                        <Button Grid.Column="2" Content="Add" Style="{StaticResource FluentButton}" Padding="10,4" Click="AddCustomModel_Click" />
                    </Grid>

                    <Grid Margin="0,2,0,12">
                        <TextBlock Text="When limited" Style="{StaticResource BaseText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="FallbackCombo" HorizontalAlignment="Right" Width="168" FontSize="11.5" SelectionChanged="FallbackCombo_Changed">
                            <ComboBoxItem Content="Try other keys first" Tag="KeysFirst" />
                            <ComboBoxItem Content="Try next model first" Tag="ModelsFirst" />
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <!-- CLI Section -->
                <StackPanel x:Name="CliSection" Visibility="Collapsed">
                    <Border x:Name="CliStatusCard" Style="{StaticResource FluentCard}" Padding="10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CliStatusGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Top" Margin="0,2,8,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="CliStatusTitle" Style="{StaticResource BaseText}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="CliStatusSub" Style="{StaticResource BaseText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <Border x:Name="CliCmdBox" Background="{DynamicResource ControlBrush}" CornerRadius="6" Padding="8,5" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CliCmdText" FontFamily="Consolas, Segoe UI" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Style="{StaticResource FluentIconButton}" Padding="4" Click="CopyCliCmd_Click" ToolTip="Copy command">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource FluentIconButton}" VerticalAlignment="Top" Click="RefreshCli_Click" ToolTip="Check again">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="MODEL" Style="{StaticResource BaseText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <StackPanel x:Name="ClaudeModelsPanel" />
                    <StackPanel x:Name="CodexModelPanel" Visibility="Collapsed">
                        <TextBox x:Name="CodexModelBox" Style="{StaticResource FluentTextBox}" FontFamily="Consolas, Segoe UI" Margin="0,0,0,8" LostFocus="CodexModelBox_LostFocus" />
                        <CheckBox x:Name="CodexFastSwitch" Content="Fast mode (low reasoning effort)" Style="{StaticResource FluentToggleSwitch}" Click="CodexFastSwitch_Click" Margin="0,0,0,8" />
                    </StackPanel>
                </StackPanel>

                <!-- Test Row -->
                <StackPanel Margin="0,4,0,4">
                    <Button x:Name="TestButton" Style="{StaticResource FluentButton}" HorizontalAlignment="Left" Padding="10,5" Click="Test_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="TestButtonLabel" Text="Send a test request" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="TestResultText" Style="{StaticResource BaseText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
