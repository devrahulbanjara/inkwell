<UserControl x:Class="Inkwell.Views.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="348">
    <StackPanel>
        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0" />
                        <GradientStop Color="#9333EA" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock x:Name="HeaderGlyph"
                           Text="&#xE70F;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="15"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Inkwell" Style="{StaticResource BaseText}" FontSize="14.5" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusLabel"
                           Style="{StaticResource BaseText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11.5"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <CheckBox x:Name="EnabledSwitch"
                      Grid.Column="2"
                      Style="{StaticResource FluentToggleSwitch}"
                      ToolTip="Turn triggers on or off"
                      Click="EnabledSwitch_Click" />
        </Grid>

        <!-- Active Provider Card -->
        <Border x:Name="ProviderCard"
                Style="{StaticResource FluentCard}"
                Padding="12,9"
                Margin="0,0,0,12"
                Cursor="Hand"
                MouseLeftButtonUp="ProviderCard_Click"
                ToolTip="Change provider, API keys and models">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="ProviderLogoHost" Margin="0,0,10,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ProviderTitle" Style="{StaticResource BaseText}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProviderDetail"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button x:Name="QuickModelButton"
                        Grid.Column="2"
                        Style="{StaticResource FluentIconButton}"
                        Margin="4,0,4,0"
                        ToolTip="Switch primary model"
                        Click="QuickModelButton_Click">
                    <TextBlock Text="&#xE950;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>

                <TextBlock Grid.Column="3"
                           Text="&#xE76C;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Error Banner -->
        <Border x:Name="ErrorBanner"
                CornerRadius="10"
                Padding="11,9"
                Margin="0,0,0,12"
                Background="#1FEF4444"
                BorderBrush="#55EF4444"
                BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="#EF4444"
                           Margin="0,1,8,0" />
                <TextBlock x:Name="ErrorText"
                           Grid.Column="1"
                           Style="{StaticResource BaseText}"
                           FontSize="11.5"
                           TextWrapping="Wrap" />
                <Button Grid.Column="2"
                        Style="{StaticResource FluentIconButton}"
                        Padding="4"
                        Margin="6,0,0,0"
                        VerticalAlignment="Top"
                        Click="DismissError_Click">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <!-- Range Segmented Picker -->
        <Border Background="{DynamicResource ControlBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="3"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RangeWeekBtn" Content="7 days" Click="RangeWeek_Click" />
                <Button x:Name="RangeMonthBtn" Grid.Column="1" Content="30 days" Click="RangeMonth_Click" />
                <Button x:Name="RangeAllBtn" Grid.Column="2" Content="All time" Click="RangeAll_Click" />
            </Grid>
        </Border>

        <!-- 2x2 Stat Cards -->
        <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Runs -->
            <Border Style="{StaticResource FluentCard}" Padding="11,9">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#F97316" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Runs" Style="{StaticResource BaseText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="RunsValue" Style="{StaticResource BaseText}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Tokens -->
            <Border Grid.Column="2" Style="{StaticResource FluentCard}" Padding="11,9">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="&#xE8EF;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#A855F7" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Tokens" Style="{StaticResource BaseText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="TokensValue" Style="{StaticResource BaseText}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="TokensDetail" Style="{StaticResource BaseText}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Words -->
            <Border Grid.Row="2" Style="{StaticResource FluentCard}" Padding="11,9">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="&#xE8A4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Words processed" Style="{StaticResource BaseText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="WordsValue" Style="{StaticResource BaseText}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- AI time -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource FluentCard}" Padding="11,9">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="AI time" Style="{StaticResource BaseText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="AiTimeValue" Style="{StaticResource BaseText}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="AiTimeDetail" Style="{StaticResource BaseText}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Activity Chart -->
        <Border Style="{StaticResource FluentCard}" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Activity" Style="{StaticResource BaseText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right"
                            Background="{DynamicResource ControlBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MetricTokensBtn" Content="Tokens" Padding="8,2" FontSize="11" Click="MetricTokens_Click" />
                            <Button x:Name="MetricRunsBtn" Content="Runs" Padding="8,2" FontSize="11" Click="MetricRuns_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Height="106">
                    <Grid x:Name="ChartGrid" />
                    <Border x:Name="EmptyChartOverlay"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="14"
                            Padding="10,5"
                            Background="{DynamicResource ControlBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock Text="No activity yet — type ?fix after any text"
                                   Style="{StaticResource BaseText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Top Templates -->
        <Border x:Name="TopTemplatesCard" Style="{StaticResource FluentCard}" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Top templates" Style="{StaticResource BaseText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                <StackPanel x:Name="TopTemplatesList" />
            </StackPanel>
        </Border>

        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,10" />

        <!-- Footer -->
        <Grid>
            <Button Style="{StaticResource FluentButton}" HorizontalAlignment="Left" Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Content="Quit" Style="{StaticResource FluentButton}" HorizontalAlignment="Right" Click="Quit_Click" />
        </Grid>
    </StackPanel>
</UserControl>
