<UserControl x:Class="Inkwell.Views.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Inkwell.Views">
    <StackPanel>
        <!-- Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="AppIconImage" Width="32" Height="32" Margin="0,0,10,0" Source="pack://application:,,,/Assets/AppIcon.png"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Inkwell" Style="{StaticResource BaseText}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusLabel" Style="{StaticResource BaseText}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <CheckBox x:Name="EnabledSwitch" Grid.Column="2" Style="{StaticResource FluentToggleSwitch}"
                      ToolTip="Turn triggers on or off" Click="EnabledSwitch_Click" />
        </Grid>

        <!-- Update available -->
        <v:InfoBar x:Name="UpdateBar" Margin="0,0,0,12" Visibility="Collapsed" />

        <!-- Active provider -->
        <Border x:Name="ProviderCard" Style="{StaticResource FluentCard}" Padding="12,10" Margin="0,0,0,12" Cursor="Hand"
                MouseLeftButtonUp="ProviderCard_Click" ToolTip="Change provider, API keys and models">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="ProviderLogoHost" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ProviderTitle" Style="{StaticResource BaseText}" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProviderDetail" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ProviderLimit" Style="{StaticResource BaseText}" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource InfoWarningIconBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="QuickModelButton" Grid.Column="2" Style="{StaticResource FluentIconButton}" Margin="4,0,2,0"
                        ToolTip="Switch model" Click="QuickModelButton_Click">
                    <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>
                <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Last error -->
        <v:InfoBar x:Name="ErrorBar" Margin="0,0,0,12" Visibility="Collapsed" />

        <!-- Range -->
        <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="2" Margin="0,0,0,12">
            <UniformGrid Rows="1">
                <RadioButton x:Name="RangeWeek" Style="{StaticResource Segment}" Content="7 days" GroupName="range" IsChecked="True" Checked="Range_Checked" />
                <RadioButton x:Name="RangeMonth" Style="{StaticResource Segment}" Content="30 days" GroupName="range" Checked="Range_Checked" />
                <RadioButton x:Name="RangeAll" Style="{StaticResource Segment}" Content="All time" GroupName="range" Checked="Range_Checked" />
            </UniformGrid>
        </Border>

        <!-- Stats -->
        <UniformGrid Columns="2" Margin="-5,-5,-5,7">
            <Border Style="{StaticResource FluentCard}" Padding="12,10" Margin="5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#F97316" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Runs" Style="{StaticResource BaseText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="RunsValue" Style="{StaticResource BaseText}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FluentCard}" Padding="12,10" Margin="5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="#" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="12" Foreground="#A855F7" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Tokens" Style="{StaticResource BaseText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="TokensValue" Style="{StaticResource BaseText}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="TokensDetail" Style="{StaticResource BaseText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FluentCard}" Padding="12,10" Margin="5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE8A4;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Words processed" Style="{StaticResource BaseText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="WordsValue" Style="{StaticResource BaseText}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FluentCard}" Padding="12,10" Margin="5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="AI time" Style="{StaticResource BaseText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="AiTimeValue" Style="{StaticResource BaseText}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="AiTimeDetail" Style="{StaticResource BaseText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Activity -->
        <Border Style="{StaticResource FluentCard}" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Activity" Style="{StaticResource BaseText}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="MetricTokens" Style="{StaticResource Segment}" Content="Tokens" FontSize="11" Padding="8,2" GroupName="metric" IsChecked="True" Checked="Metric_Checked" />
                            <RadioButton x:Name="MetricRuns" Style="{StaticResource Segment}" Content="Runs" FontSize="11" Padding="8,2" GroupName="metric" Checked="Metric_Checked" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Height="112">
                    <Grid x:Name="ChartGrid" />
                    <Border x:Name="EmptyChartOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14" Padding="12,5"
                            Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock Text="No activity yet — type ?fix after any text" Style="{StaticResource BaseText}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Top templates -->
        <Border x:Name="TopTemplatesCard" Style="{StaticResource FluentCard}" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Top templates" Style="{StaticResource BaseText}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                <StackPanel x:Name="TopTemplatesList" />
            </StackPanel>
        </Border>

        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="-16,0,-16,12" />

        <!-- Footer -->
        <Grid>
            <Button Style="{StaticResource FluentButton}" HorizontalAlignment="Left" Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Content="Quit" Style="{StaticResource FluentButton}" HorizontalAlignment="Right" Click="Quit_Click" ToolTip="Quit Inkwell" />
        </Grid>
    </StackPanel>
</UserControl>
